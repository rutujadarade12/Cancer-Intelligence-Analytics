import React, { useState, useEffect } from "react";
import { api } from "../services/api";
import { MapPin, Search, Filter, Eye, X, ArrowUpDown, Globe2, BarChart2, ShieldAlert } from "lucide-react";

export default function GeographyTab() {
  const [states, setStates] = useState([]);
  const [regions, setRegions] = useState([]);
  const [loading, setLoading] = useState(true);
  const [regionFilter, setRegionFilter] = useState("");
  const [searchTerm, setSearchTerm] = useState("");
  const [selectedState, setSelectedState] = useState(null);
  const [stateDetail, setStateDetail] = useState(null);
  const [detailLoading, setDetailLoading] = useState(false);
  const [sortField, setSortField] = useState("incident_cases");
  const [sortAsc, setSortAsc] = useState(false);

  useEffect(() => {
    setLoading(true);
    Promise.all([
      api.getStates(regionFilter, 2022),
      api.getRegions(2022)
    ])
      .then(([statesRes, regionsRes]) => {
        setStates(statesRes || []);
        setRegions(regionsRes || []);
        setLoading(false);
      })
      .catch((err) => {
        console.error("Geography fetch error:", err);
        setLoading(false);
      });
  }, [regionFilter]);

  const handleStateClick = (geoId) => {
    setSelectedState(geoId);
    setDetailLoading(true);
    api.getStateDetail(geoId)
      .then((res) => {
        setStateDetail(res);
        setDetailLoading(false);
      })
      .catch((err) => {
        console.error("State detail error:", err);
        setDetailLoading(false);
      });
  };

  const handleSort = (field) => {
    if (sortField === field) {
      setSortAsc(!sortAsc);
    } else {
      setSortField(field);
      setSortAsc(false);
    }
  };

  const filteredStates = states
    .filter((st) =>
      st.state_name.toLowerCase().includes(searchTerm.toLowerCase()) ||
      st.state_code.toLowerCase().includes(searchTerm.toLowerCase())
    )
    .sort((a, b) => {
      let valA = a[sortField] ?? 0;
      let valB = b[sortField] ?? 0;
      if (typeof valA === "string") valA = valA.toLowerCase();
      if (typeof valB === "string") valB = valB.toLowerCase();
      if (valA < valB) return sortAsc ? -1 : 1;
      if (valA > valB) return sortAsc ? 1 : -1;
      return 0;
    });

  const getBurdenColorClass = (cases) => {
    if (cases > 100000) return "badge-red";
    if (cases > 50000) return "badge-orange";
    if (cases > 20000) return "badge-blue";
    if (cases > 5000) return "badge-teal";
    return "badge-green";
  };

  return (
    <div>
      <div className="card-header" style={{ marginBottom: "20px" }}>
        <div>
          <h2 style={{ fontSize: "1.25rem", fontWeight: "700", color: "var(--text-primary)", display: "flex", alignItems: "center", gap: "8px" }}>
            <MapPin size={22} color="var(--accent-secondary)" />
            Geographic Burden & State Surveillance
          </h2>
          <p style={{ fontSize: "0.825rem", color: "var(--text-secondary)" }}>
            Epidemiological surveillance across 37 States and Union Territories with conformed regional zones & demographic growth rates.
          </p>
        </div>

        {/* Filter Controls */}
        <div style={{ display: "flex", gap: "10px", flexWrap: "wrap", alignItems: "center" }}>
          <div style={{ position: "relative" }}>
            <Search size={16} color="var(--text-muted)" style={{ position: "absolute", left: "10px", top: "10px" }} />
            <input
              type="text"
              placeholder="Search state or code..."
              className="form-control"
              style={{ paddingLeft: "32px", width: "210px" }}
              value={searchTerm}
              onChange={(e) => setSearchTerm(e.target.value)}
            />
          </div>

          <select
            className="form-control"
            value={regionFilter}
            onChange={(e) => setRegionFilter(e.target.value)}
          >
            <option value="">All 6 Regional Zones</option>
            <option value="Central">Central Zone</option>
            <option value="South">South Zone</option>
            <option value="East">East Zone</option>
            <option value="West">West Zone</option>
            <option value="North">North Zone</option>
            <option value="North East">North East Zone</option>
          </select>
        </div>
      </div>

      {/* Regional Zonal Distribution Cards */}
      <div className="grid-3" style={{ marginBottom: "24px" }}>
        {regions.map((rg, idx) => (
          <div
            key={idx}
            className="card"
            style={{
              cursor: "pointer",
              borderLeft: regionFilter === rg.region_zone ? "4px solid var(--accent-secondary)" : "1px solid var(--border-color)",
              background: regionFilter === rg.region_zone ? "var(--bg-card-hover)" : "var(--bg-card)"
            }}
            onClick={() => setRegionFilter(regionFilter === rg.region_zone ? "" : rg.region_zone)}
          >
            <div className="card-header" style={{ marginBottom: "8px" }}>
              <span style={{ fontWeight: "600", fontSize: "0.95rem" }}>{rg.region_zone} Zone</span>
              <span className="badge badge-teal">{rg.state_count} States</span>
            </div>
            <div style={{ fontSize: "1.35rem", fontWeight: "700", color: "var(--text-primary)", marginBottom: "6px" }}>
              {rg.total_regional_cases?.toLocaleString()} <span style={{ fontSize: "0.75rem", fontWeight: "400", color: "var(--text-secondary)" }}>cases</span>
            </div>
            <div style={{ display: "flex", alignItems: "center", gap: "8px" }}>
              <div className="prog-container">
                <div
                  className="prog-fill"
                  style={{ width: `${rg.regional_share_pct}%`, background: "var(--accent-secondary)" }}
                />
              </div>
              <span style={{ fontSize: "0.75rem", fontWeight: "600", color: "var(--accent-secondary)" }}>
                {rg.regional_share_pct}%
              </span>
            </div>
          </div>
        ))}
      </div>

      {/* State Burden Heat Topology / Interactive State Cards */}
      <div className="card" style={{ marginBottom: "24px" }}>
        <div className="card-header">
          <div>
            <h3 style={{ fontSize: "1rem", fontWeight: "600", display: "flex", alignItems: "center", gap: "8px" }}>
              <Globe2 size={18} color="var(--accent-primary)" />
              National Burden Heat Distribution (37 States & UTs)
            </h3>
            <p style={{ fontSize: "0.8rem", color: "var(--text-secondary)" }}>
              Categorized into epidemiological demand tiers: Red &gt;100k, Orange 50k–100k, Blue 20k–50k, Teal 5k–20k, Green &lt;5k. Click any tile for full state projection profile.
            </p>
          </div>
          <div style={{ display: "flex", gap: "6px", flexWrap: "wrap", fontSize: "0.7rem" }}>
            <span className="badge badge-red">&gt;100k (Severe)</span>
            <span className="badge badge-orange">50k-100k (High)</span>
            <span className="badge badge-blue">20k-50k (Moderate)</span>
            <span className="badge badge-teal">5k-20k (Low)</span>
            <span className="badge badge-green">&lt;5k (Minimal)</span>
          </div>
        </div>

        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(130px, 1fr))", gap: "8px" }}>
          {filteredStates.map((st) => (
            <button
              key={st.geo_id}
              onClick={() => handleStateClick(st.geo_id)}
              style={{
                background: selectedState === st.geo_id ? "var(--bg-card-hover)" : "var(--bg-secondary)",
                border: selectedState === st.geo_id ? "2px solid var(--accent-secondary)" : "1px solid var(--border-color)",
                borderRadius: "var(--radius-sm)",
                padding: "10px 8px",
                textAlign: "left",
                cursor: "pointer",
                transition: "all 0.15s ease",
                display: "flex",
                flexDirection: "column",
                gap: "4px"
              }}
            >
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
                <span style={{ fontSize: "0.7rem", fontWeight: "700", color: "var(--accent-secondary)" }}>{st.state_code}</span>
                <span className={`badge ${getBurdenColorClass(st.incident_cases)}`} style={{ fontSize: "0.625rem", padding: "1px 5px" }}>
                  {st.incident_cases > 1000 ? `${(st.incident_cases / 1000).toFixed(0)}k` : st.incident_cases}
                </span>
              </div>
              <div style={{ fontSize: "0.775rem", fontWeight: "600", color: "var(--text-primary)", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>
                {st.state_name}
              </div>
              <div style={{ fontSize: "0.675rem", color: "var(--text-muted)" }}>
                {st.region_zone} Zone
              </div>
            </button>
          ))}
        </div>
      </div>

      {/* Main State Surveillance Table */}
      {loading ? (
        <div style={{ padding: "40px", textAlign: "center", color: "var(--text-secondary)" }}>Loading state surveillance data...</div>
      ) : (
        <div className="card">
          <div className="card-header">
            <h3 style={{ fontSize: "1rem", fontWeight: "600" }}>
              State Epidemiological Surveillance & Projections Matrix (N = {filteredStates.length})
            </h3>
            <span style={{ fontSize: "0.8rem", color: "var(--text-muted)" }}>Click column headers to sort</span>
          </div>

          <div className="table-responsive">
            <table className="data-table">
              <thead>
                <tr>
                  <th>Rank</th>
                  <th onClick={() => handleSort("state_name")} style={{ cursor: "pointer" }}>
                    State / UT <ArrowUpDown size={12} style={{ display: "inline" }} />
                  </th>
                  <th>Code</th>
                  <th onClick={() => handleSort("region_zone")} style={{ cursor: "pointer" }}>
                    Region Zone <ArrowUpDown size={12} style={{ display: "inline" }} />
                  </th>
                  <th onClick={() => handleSort("incident_cases")} style={{ cursor: "pointer" }}>
                    2022 Incidence <ArrowUpDown size={12} style={{ display: "inline" }} />
                  </th>
                  <th onClick={() => handleSort("national_share_pct")} style={{ cursor: "pointer" }}>
                    National Share % <ArrowUpDown size={12} style={{ display: "inline" }} />
                  </th>
                  <th onClick={() => handleSort("cagr_observed")} style={{ cursor: "pointer" }}>
                    Observed CAGR <ArrowUpDown size={12} style={{ display: "inline" }} />
                  </th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                {filteredStates.map((st, idx) => (
                  <tr key={st.geo_id}>
                    <td><span className="badge badge-gray">{idx + 1}</span></td>
                    <td style={{ fontWeight: "600" }}>{st.state_name}</td>
                    <td><span className="badge badge-teal">{st.state_code}</span></td>
                    <td><span className="badge badge-gray">{st.region_zone}</span></td>
                    <td style={{ fontWeight: "700" }}>{st.incident_cases?.toLocaleString()}</td>
                    <td>
                      <div style={{ display: "flex", alignItems: "center", gap: "8px" }}>
                        <div className="prog-container" style={{ width: "70px" }}>
                          <div
                            className="prog-fill"
                            style={{ width: `${Math.min(st.national_share_pct * 6, 100)}%`, background: "var(--accent-primary)" }}
                          />
                        </div>
                        <span style={{ fontSize: "0.75rem", minWidth: "36px" }}>{st.national_share_pct}%</span>
                      </div>
                    </td>
                    <td>
                      <span className="badge badge-orange">
                        {st.cagr_observed ? `${(st.cagr_observed * 100).toFixed(2)}%` : "N/A"}
                      </span>
                    </td>
                    <td>
                      <button
                        onClick={() => handleStateClick(st.geo_id)}
                        className="btn btn-outline"
                        style={{ padding: "4px 10px", fontSize: "0.75rem" }}
                      >
                        <Eye size={13} /> Inspect
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {/* State Detail Drawer Modal */}
      {selectedState && (
        <div style={{
          position: "fixed",
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          background: "rgba(0, 0, 0, 0.75)",
          display: "flex",
          justifyContent: "flex-end",
          zIndex: 1000
        }}>
          <div style={{
            width: "100%",
            maxWidth: "520px",
            background: "var(--bg-card)",
            height: "100%",
            overflowY: "auto",
            padding: "24px",
            boxShadow: "var(--shadow-lg)",
            display: "flex",
            flexDirection: "column",
            gap: "20px"
          }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", borderBottom: "1px solid var(--border-color)", paddingBottom: "16px" }}>
              <div>
                <h3 style={{ fontSize: "1.2rem", fontWeight: "700", color: "var(--text-primary)" }}>
                  {stateDetail?.geography?.state_name || "State Profile"}
                </h3>
                <span className="badge badge-teal" style={{ marginTop: "4px" }}>
                  {stateDetail?.geography?.region_zone} Zone • Code: {stateDetail?.geography?.state_code}
                </span>
              </div>
              <button
                onClick={() => setSelectedState(null)}
                className="btn btn-outline"
                style={{ padding: "6px" }}
              >
                <X size={18} />
              </button>
            </div>

            {detailLoading ? (
              <div style={{ padding: "40px", textAlign: "center" }}>Loading state details...</div>
            ) : stateDetail ? (
              <div style={{ display: "flex", flexDirection: "column", gap: "18px" }}>
                <div className="alert-box" style={{ background: "rgba(6, 182, 212, 0.08)", borderLeftColor: "var(--accent-secondary)" }}>
                  <ShieldAlert size={18} color="var(--accent-secondary)" style={{ flexShrink: 0 }} />
                  <div style={{ fontSize: "0.8rem" }}>
                    Historical trajectory (2019–2022) derives from ICMR-NCRP mathematical model estimates. 2026 forecast represents Kumar et al. moderated exponential projection.
                  </div>
                </div>

                {/* Trajectory Table */}
                <div>
                  <h4 style={{ fontSize: "0.95rem", fontWeight: "600", marginBottom: "10px" }}>
                    Multi-Year Trajectory & Projections
                  </h4>
                  <div className="table-responsive">
                    <table className="data-table">
                      <thead>
                        <tr>
                          <th>Year</th>
                          <th>Classification</th>
                          <th>Cases</th>
                          <th>National Share</th>
                        </tr>
                      </thead>
                      <tbody>
                        {stateDetail.trajectory?.map((tr, idx) => (
                          <tr key={idx}>
                            <td style={{ fontWeight: "600" }}>{tr.year}</td>
                            <td><span className={`badge ${tr.epoch_category === "Projected" ? "badge-orange" : "badge-teal"}`}>{tr.epoch_category}</span></td>
                            <td style={{ fontWeight: "700" }}>{tr.incident_cases?.toLocaleString()}</td>
                            <td>{tr.national_share_pct}%</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>

                {/* Population and Capital Metrics */}
                <div className="card" style={{ background: "var(--bg-secondary)" }}>
                  <h4 style={{ fontSize: "0.9rem", fontWeight: "600", marginBottom: "8px" }}>
                    Geographic & Demographic Metadata
                  </h4>
                  <div style={{ fontSize: "0.825rem", color: "var(--text-secondary)", display: "flex", flexDirection: "column", gap: "6px" }}>
                    <div><strong>Capital City:</strong> {stateDetail.geography?.capital || "N/A"}</div>
                    <div><strong>Census Population:</strong> {stateDetail.geography?.census_population_2011 ? stateDetail.geography.census_population_2011.toLocaleString() : "Official Census"}</div>
                    <div><strong>Historical CAGR (2019–2022):</strong> {stateDetail.summary_metrics?.cagr_observed ? `${(stateDetail.summary_metrics.cagr_observed * 100).toFixed(2)}%` : "N/A"}</div>
                    <div><strong>Projected CAGR (2022–2026):</strong> {stateDetail.summary_metrics?.cagr_projected ? `${(stateDetail.summary_metrics.cagr_projected * 100).toFixed(2)}%` : "N/A"}</div>
                  </div>
                </div>
              </div>
            ) : null}
          </div>
        </div>
      )}
    </div>
  );
}
