  "decision_tree_classification": {
    "task_name": "State Cancer Burden Tier Classification",
    "sample_size": 37,
    "target_variable": "burden_tier (4 Analytical Volume Quartiles: Low, Moderate, High, Severe)",
    "category_semantics": "Analytical population-level burden categories, NOT patient clinical severity.",
    "quartile_thresholds": {
      "Tier_1_Low": "<= 1,700 cases (Lowest 25% volume)",
      "Tier_2_Moderate": "1,700 - 26,735 cases",
      "Tier_3_High": "26,735 - 73,382 cases",
      "Tier_4_Severe": "> 73,382 cases (Top 25% volume: UP, MH, WB, BR, etc.)"
    },
    "features_used": [
      "region_Central",
      "region_East",
      "region_North",
      "region_North East",
      "region_South",
      "region_West",
      "cagr_observed",
      "cagr_projected"
    ],
    "leakage_prevention": "Raw cases and percentage shares strictly excluded from feature vector.",
    "model_parameters": {
      "criterion": "gini",
      "max_depth": 3,
      "min_samples_split": 4,
      "random_state": 42
    },
    "evaluation": {
      "accuracy": 0.6216,
      "macro_f1": 0.5302,
      "confusion_matrix": [
        [
          6,
          2,
          0,
          2
        ],
        [
          1,
          8,
          0,
          0
        ],
        [
          1,
          2,
          0,
          6
        ],
        [
          0,
          0,
          0,
          9
        ]
      ],
      "classes": [
        "Tier_1_Low",
        "Tier_2_Moderate",
        "Tier_3_High",
        "Tier_4_Severe"
      ]
    },
    "tree_rules_text": "|--- cagr_observed <= 0.03\n|   |--- region_North <= 0.50\n|   |   |--- region_North East <= 0.50\n|   |   |   |--- class: Tier_4_Severe\n|   |   |--- region_North East >  0.50\n|   |   |   |--- class: Tier_2_Moderate\n|   |--- region_North >  0.50\n|   |   |--- cagr_observed <= 0.03\n|   |   |   |--- class: Tier_2_Moderate\n|   |   |--- cagr_observed >  0.03\n|   |   |   |--- class: Tier_1_Low\n|--- cagr_observed >  0.03\n|   |--- region_North East <= 0.50\n|   |   |--- class: Tier_1_Low\n|   |--- region_North East >  0.50\n|   |   |--- class: Tier_2_Moderate\n",
    "interpretation": "Classifies states into healthcare burden tiers based on geographical zone and population growth momentum."
  },
  "naive_bayes_classification": {
    "task_name": "Cancer Site Tobacco-Association Risk Profiling",
