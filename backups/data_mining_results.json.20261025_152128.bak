    "forecast_2026_trajectory_evaluation": {
      "comparison": "Kumar et al. Moderated Exponential Model vs Linear Extrapolation",
      "metrics": {
        "mae": 2896.91,
        "rmse": 4570.25,
        "r2": 0.992231
      },
      "interpretation": "Out-of-sample forward evaluation: Linear continuation aligns closely with Kumar et al. moderated exponential projection with R2 = 0.9922, verifying macroeconomic trajectory consistency."
    },
    "methodological_limitations": "Training and test targets derive from demographic model extrapolations rather than individual patient censuses. 2026 values represent projected horizons, not observed empirical registries."
